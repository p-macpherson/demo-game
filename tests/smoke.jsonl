// Goblin Gold: the goblin walks, opens a chest (gold, lid, wave), and the HUD counts it.
{"cmd": "wait", "frames": 30}
{"cmd": "ui_click", "label": "Play"}
{"cmd": "wait", "frames": 10}
// Chests start closed, not swinging shut.
{"cmd": "assert", "entity": "Chest 2", "component": "Animator", "field": "finished", "value": true}
// The theme started with the game (the engine logs sounds with audio off).
{"cmd": "assert", "sound": "music/goblin-gold/goblin-gold.ogg"}
{"cmd": "assert", "sound": "forest/forest.ogg"}
{"cmd": "assert", "entity": "Goblin", "component": "Character_Controller", "field": "grounded", "value": true}
{"cmd": "screenshot", "path": "build/smoke-start.png"}
// Walking on grass (off every path) makes footsteps but no dust.
{"cmd": "console", "line": "teleport -8 -6"}
{"cmd": "wait", "frames": 10}
{"cmd": "action", "name": "move_y", "state": "hold"}
{"cmd": "wait", "frames": 60}
{"cmd": "assert", "sound": "footstep/footstep", "frames": 40}
{"cmd": "action", "name": "move_y", "state": "release"}
{"cmd": "assert", "entity": "Goblin", "component": "Player", "field": "dust_puffs", "value": 0}
// Back at the hub: walking the cobbles along the path to chest 4 kicks up dust.
{"cmd": "console", "line": "teleport 0 0"}
{"cmd": "wait", "frames": 10}
{"cmd": "action", "name": "move_y", "state": "hold"}
{"cmd": "wait", "frames": 45}
{"cmd": "assert", "entity": "Goblin", "component": "Player", "field": "dust_puffs", "op": ">", "value": 0}
{"cmd": "assert", "effect": "effects/footstep-dust.json", "ok": true, "min_particles": 1}
{"cmd": "assert", "entity": "Goblin Model", "component": "Animator", "field": "clip", "value": "run"}
// Footsteps while walking.
{"cmd": "assert", "sound": "footstep/footstep", "frames": 40}
{"cmd": "screenshot", "path": "build/smoke-walk.png"}
{"cmd": "action", "name": "move_y", "state": "release"}
{"cmd": "assert", "entity": "Goblin", "component": "Transform", "field": "position.z", "op": ">", "value": 1}
{"cmd": "console", "line": "teleport 4 4.8"}
{"cmd": "wait", "frames": 20}
{"cmd": "assert", "entity": "Chest 1", "component": "Chest", "field": "open", "value": false}
// Gold pile of the first chest (first "Gold Pile" in the scene) is hidden until the lid lifts.
{"cmd": "assert", "entity": "Gold Pile", "component": "Mesh_Renderer", "field": "hidden", "value": true}
{"cmd": "action", "name": "interact", "state": "tap"}
{"cmd": "wait", "frames": 2}
{"cmd": "assert", "effect": "effects/chest-open.json", "ok": true, "min_particles": 1}
{"cmd": "assert", "sound": "treasure-found", "frames": 5}
{"cmd": "assert", "sound": "chest-open/chest-open.ogg", "frames": 5}
{"cmd": "assert", "entity": "Chest 1", "component": "Chest", "field": "open", "value": true}
{"cmd": "assert", "entity": "Goblin Model", "component": "Animator", "field": "clip", "value": "wave"}
{"cmd": "wait", "frames": 40}
{"cmd": "assert", "entity": "Gold Pile", "component": "Mesh_Renderer", "field": "hidden", "value": false}
// The gold follows the lid by about half a second.
{"cmd": "assert", "sound": "gold/gold.ogg", "frames": 40}
// The pile's gold glints loop over it.
{"cmd": "assert", "effect": "effects/gold-glints.json", "ok": true}
{"cmd": "assert", "entity": "Screens", "component": "Screen_State", "field": "glints", "value": 1}
{"cmd": "screenshot", "path": "build/smoke-open.png"}
// Step round to the far side so the camera sees into the open chest unobstructed.
{"cmd": "console", "line": "teleport 4.3 7.6"}
{"cmd": "wait", "frames": 40}
{"cmd": "screenshot", "path": "build/smoke-gold.png"}
{"cmd": "assert", "entity": "Chest 2", "component": "Chest", "field": "open", "value": false}
// The stepping stones toward chest 4 don't block the goblin.
{"cmd": "wait", "frames": 30}
{"cmd": "console", "line": "teleport -0.8 1"}
{"cmd": "wait", "frames": 10}
{"cmd": "action", "name": "move_y", "state": "hold"}
{"cmd": "wait", "frames": 60}
{"cmd": "action", "name": "move_y", "state": "release"}
{"cmd": "assert", "entity": "Goblin", "component": "Transform", "field": "position.z", "op": ">", "value": 2.9}
// The treasure map: walk up, pick it up with E, it disappears and the HUD says so.
{"cmd": "console", "line": "teleport -5.1 -3.1"}
{"cmd": "wait", "frames": 20}
{"cmd": "assert", "entity": "Treasure Map", "exists": true}
{"cmd": "action", "name": "interact", "state": "tap"}
{"cmd": "wait", "frames": 2}
{"cmd": "assert", "sound": "map-pickup/map-pickup.ogg", "frames": 5}
{"cmd": "wait", "frames": 5}
{"cmd": "assert", "entity": "Treasure Map", "exists": false}
{"cmd": "screenshot", "path": "build/smoke-map.png"}
